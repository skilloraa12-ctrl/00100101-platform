# Supabase project backing the invite-only course login (see
# supabase/course_access.sql for the one-time setup). Leave both unset for
# local dev — CourseAccessGate then skips the login gate entirely, so
# working on course content never requires a Supabase project.
#
# Values: Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
